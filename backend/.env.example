MONGO_URL=mongodb://localhost:27017
DB_NAME=codeguard
# Groq (OpenAI-compatible) key for AI triage — optional, static scanning works without it
GROQ_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
# Raises the GitHub API rate limit from 60/h and enables private repos the token can read
GITHUB_TOKEN=
# Frontend origins allowed to call the API with the session cookie ("*" is ignored)
CORS_ORIGINS=http://localhost:3000,https://codevigil.netlify.app
# Optional: allow Netlify deploy previews (only if previews are never built from fork PRs)
# CORS_ORIGIN_REGEX=^https://deploy-preview-\d+--codevigil\.netlify\.app$
# Local-only passwordless login (docker-compose). Never enable in production.
ALLOW_DEV_LOGIN=false
