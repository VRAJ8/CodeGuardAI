{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{server.py,codeguard/**}",
      "excludeFiles": "{tests/**,Dockerfile,Procfile}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
